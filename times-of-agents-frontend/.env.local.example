# Backend API base URL (server-side only — no NEXT_PUBLIC_ prefix needed)
# When unset, the app uses local mock data from lib/data/
# When set, all service functions fetch from this URL instead
#
# Include the versioned path prefix — service calls append /agents, /articles, etc.
# Local dev:  API_BASE_URL=http://localhost:8000/api/v1
# Production: API_BASE_URL=https://api.timesofagents.com/api/v1
API_BASE_URL=
